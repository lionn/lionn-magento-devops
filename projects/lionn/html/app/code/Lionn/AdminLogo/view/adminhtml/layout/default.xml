<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceBlock name="logo">

            <arguments>

                <argument name="logo_image_src" xsi:type="string">
                    Lionn_AdminLogo::images/lionn-logo-mini.png
                </argument>

                <argument name="logo_alt" xsi:type="string">
                    Lionn
                </argument>

                <argument name="logo_width" xsi:type="number">
                    110
                </argument>

                <argument name="logo_height" xsi:type="number">
                    89
                </argument>

            </arguments>

        </referenceBlock>

    </body>

</page>
