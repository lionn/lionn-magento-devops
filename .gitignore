# ============================================================
# Lionn Magento DevOps
# Arquivos locais, temporários e sensíveis
# ============================================================

# Variáveis de ambiente
.env
.env.*
!.env.example
!.env.sample

# Chaves privadas e certificados
*.key
*.pem
*.crt
*.p12
*.pfx

# Logs
*.log
logs/

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs e editores
.idea/
.vscode/

# Dados persistentes de containers
**/data/

# Mas mantém a estrutura da pasta data/
!**/data/.gitkeep

# Certificados SSL (exceções pros exemplos)
!nginx/ssl/*.key.example
!nginx/ssl/*.pem.example
!nginx/ssl/.gitkeep

# Terraform - estado local
**/.terraform/
*.tfstate
*.tfstate.*

# Terraform - variáveis locais
*.tfvars
*.tfvars.json

# Terraform - lock file
!**/.terraform.lock.hcl

# Composer lock (você decidiu não subir)
composer.lock
html/composer.lock

# ============================================================
# Fim
# ============================================================
