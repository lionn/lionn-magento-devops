root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[{composer,auth}.json]
indent_size = 4

[db_schema_whitelist.json]
indent_size = 4
trim_trailing_whitespace = false

[*.xml]
indent_size = 4
indent_style = space

[*.php]
indent_size = 4
indent_style = space

[*.sh]
indent_size = 4
indent_style = space
end_of_line = lf

[*.conf]
indent_size = 4
indent_style = space

[Makefile]
indent_style = tab
