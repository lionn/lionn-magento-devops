# ============================================================
# MAGENTO 2 — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para o .env do seu projeto e preencha os valores reais:
#
#     cp .env.example .env
#
# NUNCA suba o .env real para o repositório.
# ============================================================


# ------------------------------------------------------------
# BANCO DE DADOS (MariaDB)
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=troque_essa_senha_root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=troque_essa_senha_magento


# ------------------------------------------------------------
# REDIS (cache, sessão, page cache)
# ------------------------------------------------------------
REDIS_PASSWORD=troque_essa_senha_redis


# ------------------------------------------------------------
# OPENSEARCH (search engine)
# ------------------------------------------------------------
# Não precisa de senha no modo single-node com security disabled.
# Se você habilitar security, adicione:
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=troque_essa_senha


# ------------------------------------------------------------
# MAGENTO — Instalação
# ------------------------------------------------------------
MAGENTO_BASE_URL=https://seusite.com.br

MAGENTO_DB_HOST=magento_db
MAGENTO_DB_NAME=magento
MAGENTO_DB_USER=magento
MAGENTO_DB_PASSWORD=troque_essa_senha_magento

MAGENTO_ADMIN_FRONTNAME=admin
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=seu@email.com
MAGENTO_ADMIN_USER=seu_usuario
MAGENTO_ADMIN_PASSWORD=troque_essa_senha_admin

MAGENTO_LANGUAGE=pt_BR
MAGENTO_CURRENCY=BRL
MAGENTO_TIMEZONE=America/Sao_Paulo


# ------------------------------------------------------------
# OPENSEARCH — Configuração do Magento
# ------------------------------------------------------------
OPENSEARCH_HOST=magento_opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento2
OPENSEARCH_TIMEOUT=15


# ------------------------------------------------------------
# REDIS — Configuração do Magento
# ------------------------------------------------------------
REDIS_HOST=magento_redis
REDIS_PORT=6379
REDIS_DB_SESSION=2
REDIS_DB_CACHE=1
REDIS_DB_PAGE_CACHE=3
