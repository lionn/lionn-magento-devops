/* Estilo do modal */
.dynamic-youtube-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

/* Conteúdo do modal */
.dynamic-youtube-modal .modal-content {
    background: #fff;
    padding: 10px;
    border-radius: 10px;
    width: 80%;
    max-width: 600px;
    position: relative;
    text-align: center;
}

/* Botão de fechar */
.dynamic-youtube-modal .close-modal {
    position: absolute;
    top: 10px;
    right: 10px;
    background: red;
    color: #fff;
    border: none;
    font-size: 16px;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
}
