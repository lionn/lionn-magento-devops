# ============================================================
# Lionn Magento DevOps
# Arquivos locais, temporários e sensíveis
# ============================================================

# Variáveis de ambiente
.env
.env.*
!.env.example
!.env.sample

# Chaves privadas e certificados
*.key
*.pem
*.crt
*.p12
*.pfx

# Logs
*.log
logs/

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs e editores
.idea/
.vscode/

# Dados persistentes de containers
**/data/

# Terraform - estado local
**/.terraform/
*.tfstate
*.tfstate.*

# Terraform - variáveis locais
*.tfvars
*.tfvars.json

# Terraform - lock file
!**/.terraform.lock.hcl

# ============================================================
# Fim
# ============================================================
