/* Modal */
.dynamic-youtube-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

/* Conteúdo do modal */
.dynamic-youtube-modal .modal-content {
    background: #fff;
    padding: 10px;
    border-radius: 10px;
    width: 80%;
    max-width: 600px;
    position: relative;
    text-align: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

/* Botão de fechar */
.dynamic-youtube-modal .close-modal {
    position: absolute;
    top: -40px; /* Ajuste para ficar logo acima do modal */
    right: 10px; /* Alinhado à borda direita do modal */
    background: red;
    color: #fff;
    border: none;
    font-size: 16px;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
    z-index: 10000; /* Garante visibilidade acima do modal */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

/* Responsividade */
@media screen and (max-width: 600px) {
    .dynamic-youtube-modal .close-modal {
        font-size: 14px; /* Botão menor para telas pequenas */
        top: -30px; /* Ajusta distância em telas menores */
    }
}
