/* Estilo do modal */
.dynamic-youtube-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

/* Conteúdo do modal */
.dynamic-youtube-modal .modal-content {
    background: #fff;
    padding: 10px;
    border-radius: 10px;
    width: 80%;
    max-width: 600px;
    position: relative; /* Necessário para que o botão feche fique posicionado dentro do modal */
    text-align: center;
}

/* Botão de fechar */
.dynamic-youtube-modal .close-modal {
    position: absolute;
    top: -28px;  /* Mantendo o botão na posição desejada */
    right: 10px;
    background: #f36422;
    color: #fff;
    border: none;
    font-size: 16px;
    padding: 5px 10px;
    border-radius: 10px 10px 0 0;  /* Apenas o topo arredondado */
    cursor: pointer;
    z-index: 10000;  /* Garante visibilidade acima do modal */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}

/* Responsividade - Ajustes para telas menores */
@media screen and (max-width: 600px) {
    .dynamic-youtube-modal .close-modal {
        font-size: 14px;  /* Ajuste no tamanho da fonte */
        padding: 5px 8px;  /* Ajuste no padding */
        top: -28px;  /* Garante que a posição não altere */
        right: 8px;  /* Ajuste para o alinhamento */
    }
}
